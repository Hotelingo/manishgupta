# Public address of this site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://camanishgupta.com

# --- Email sign-ups (optional) -------------------------------------------------
# The site has no database. Sign-ups are forwarded to the book site's lead store
# so there is one email list. Leave these empty and the form says sign-ups open
# soon. See docs/EDITING.md, "Email sign-ups", before switching this on.
LEADS_ENDPOINT=
PORTFOLIO_LEAD_TYPE=portfolio
PRIVACY_POLICY_VERSION=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID (optional).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

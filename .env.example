# Public address of this site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://camanishgupta.com

# --- Email sign-ups ------------------------------------------------------------
# Sign-ups are forwarded to the book site's list (type "portfolio").
# Set this once the book site change (hotel-finance-book PR #307) is live:
LEADS_ENDPOINT=https://book.ehotelmanagementschool.com/api/leads
# Only if the book site uses Cloudflare Turnstile: its public site key, with
# camanishgupta.com added to the widget's allowed hostnames in Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional. Defaults to the book site's current policy version (2026-09-08).
PRIVACY_POLICY_VERSION=

# Google Analytics 4 measurement ID (optional).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

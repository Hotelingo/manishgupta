# Public address of this site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://camanishgupta.com

# Shared Supabase project (the same one as book.ehotelmanagementschool.com).
# Use ONLY the publishable key here. Never add the service-role key to this project.
# Leave both empty to run on the built-in sample content in lib/content/seed.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email sign-ups are forwarded to the book site's lead endpoint, so there is one list.
# Leave empty until the book site accepts the "portfolio" lead type (see docs/DATABASE.md).
LEADS_ENDPOINT=https://book.ehotelmanagementschool.com/api/leads
PORTFOLIO_LEAD_TYPE=portfolio
PRIVACY_POLICY_VERSION=

# Cloudflare Turnstile: the same site key as the book site. Add camanishgupta.com
# to the widget's allowed hostnames in Cloudflare first.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID (optional).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
